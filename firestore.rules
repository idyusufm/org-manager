rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only people signed in (i.e. accounts you created for your ~20 users)
    // can read or write. There is no public signup flow in this app, so
    // the only accounts that exist are ones you add in the Firebase console.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
